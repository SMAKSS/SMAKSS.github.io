{
  "name": "smakss-website",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit -p tsconfig.app.json --incremental && tsc --noEmit -p tsconfig.node.json --incremental",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "cf:deploy": "wrangler deploy --name=${CLOUDFLARE_WORKER_NAME:-smakss-website}",
    "cf:dev": "pnpm build && wrangler dev --name=${CLOUDFLARE_WORKER_NAME:-smakss-website}",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@react-router/cloudflare": "^7.18.5",
    "@react-router/node": "^7.18.5",
    "@react-router/serve": "^7.18.5",
    "clsx": "^2.1.1",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.4",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.6.6",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^7.18.5",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
